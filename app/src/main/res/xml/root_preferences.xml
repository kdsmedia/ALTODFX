<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="About">
        <Preference
            android:title="@string/app_name"
            android:key="about"
            android:summary="1.0 Build 4"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="Audio">
        <ListPreference
            android:title="Input Device"
            android:key="input"
            android:defaultValue="auto"
            android:entries="@array/audio_input_entries"
            android:entryValues="@array/audio_input_values"/>

        <ListPreference
            android:title="Output Device"
            android:key="output"
            android:defaultValue="auto"
            android:entries="@array/audio_output_entries"
            android:entryValues="@array/audio_output_values"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Saving">

        <DropDownPreference
            android:title="MP3 Encode Preset"
            android:key="lame_preset"
            android:defaultValue="1001"
            android:entries="@array/mp3_presets"
            android:entryValues="@array/mp3_presets_values"/>
    </PreferenceCategory>

</PreferenceScreen>